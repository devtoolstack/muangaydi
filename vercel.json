{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(assets|icons|logo.png|manifest.json|robots.txt|sitemap.xml|sitemap_index.xml|sitemap_pages.xml|sitemap_products.xml|rss.xml|feed.xml|api/.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
